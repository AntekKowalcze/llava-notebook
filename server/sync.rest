@dupAttachmentId = {{$guid}}

POST {{baseUrl}}/sync/sync-check
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "to_check": [
    {
      "local_id": "{{$guid}}",
      "cloud_id": "{{noteMongoIdZal}}",
