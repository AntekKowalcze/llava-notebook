@baseUrl = http://127.0.0.1:3000
@seedValidRefresh = 11111111-1111-1111-1111-111111111111.sig_valid_seed
@seedExpiredRefresh = 22222222-2222-2222-2222-222222222222.sig_expired_seed


### Health check
GET {{baseUrl}}/

### Register (optional setup)
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "user": {
        "email": "d@example.com",
        "password_hash": "$argon2id$v=19$m=65536,t=3,p=4$c2FsdHNhbHRzYWx0c2FsdA$hash",
        "password_salt": "c2FsdHNhbHRzYWx0c2FsdA==",
        "master_key_enc": "AQID/xAQEB8fHx8=",
        "master_key_nonce": "CQgHBgUEAwIB",
        "kek_salt": "c2FsdHNhbHRzYWx0",
